{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "firefox",
            "request": "launch",
            "name": "Launch Firefox",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}",
            "pathMappings": [
                {
                    "url": "http://localhost:5173/node_modules/@beadee/grid-editor",
                    "path": "${workspaceFolder}/packages/beadee-grid-editor"
                },
                {
                    "url": "http://localhost:5173/node_modules/@beadee/pattern-editor",
                    "path": "${workspaceFolder}/packages/beadee-pattern-editor"
                },
                {
                    "url": "http://localhost:5173/src",
                    "path": "${workspaceFolder}/apps/web/src"
                }
            ]
        }
    ]
}
